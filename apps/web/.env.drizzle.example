# .env.drizzle
# Database connection strings for Drizzle migrations.
# The real .env.drizzle in the repo is encrypted with dotenvx; this template
# shows the variables it must contain. See .env.example for setup notes.
#
# DEV:  Local Docker Postgres — uses the `postgres` superuser for migrations (DDL)
# PROD: Direct Postgres connection string (the same one used to create the
#       Hyperdrive config in Cloudflare)

DATABASE_URL_DEV=postgres://postgres:postgres@localhost:5432/riposte
DATABASE_URL_PROD=postgres://user:password@host:5432/dbname
