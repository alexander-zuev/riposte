# .env.keys
# Private decryption keys for dotenvx-encrypted env files in this directory.
# Copy this file to `.env.keys` (gitignored) and paste the real keys.
#
# - DOTENV_PRIVATE_KEY         decrypts apps/web/.env
#   (paired with DOTENV_PUBLIC_KEY at the top of .env)
# - DOTENV_PRIVATE_KEY_DRIZZLE decrypts apps/web/.env.drizzle
#   (paired with DOTENV_PUBLIC_KEY_DRIZZLE at the top of .env.drizzle)
#
# Get these from a teammate or the secrets manager — do NOT commit .env.keys.

DOTENV_PRIVATE_KEY=""
DOTENV_PRIVATE_KEY_DRIZZLE=""
