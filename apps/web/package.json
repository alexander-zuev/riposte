{
  "name": "@riposte/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env dev",
    "dev": "CLOUDFLARE_ENV=dev dotenvx run -- vite",
    "build": "wrangler types --env staging && CLOUDFLARE_ENV=staging vite build --mode staging && oxlint src --quiet && tsc -p tsconfig.build.json",
    "build:prerender": "wrangler types --env staging && CLOUDFLARE_ENV=staging RIPOSTE_PRERENDER=1 vite build --mode staging && oxlint src --quiet && tsc -p tsconfig.build.json",
    "build:prod": "wrangler types --env prod && CLOUDFLARE_ENV=prod vite build --mode production && oxlint src --quiet && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "preview": "dotenvx run -- vite preview",
    "test": "vitest run --reporter=dot --silent",
    "test:unit": "vitest run --project unit --reporter=dot --silent",
    "test:integration": "vitest run --project integration --reporter=dot --silent",
    "test:e2e": "dotenvx run -f .env.test -- playwright test -c playwright.config.ts",
    "test:e2e:ui": "dotenvx run -f .env.test -- playwright test -c playwright.config.ts --ui",
    "test:verbose": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint src --quiet",
    "lint:fix": "oxlint src --fix --quiet",
    "storybook": "dotenvx run -- storybook dev -p 6006",
    "build-storybook": "dotenvx run -- storybook build",
    "deploy": "pnpm db:migrate:staging && wrangler deploy",
    "deploy:prod": "pnpm db:migrate:prod && wrangler deploy",
    "db:generate": "dotenvx run -f .env.drizzle -- drizzle-kit generate",
    "db:generate:custom": "dotenvx run -f .env.drizzle -- drizzle-kit generate --custom",
    "db:migrate:dev": "dotenvx run -f .env.drizzle -- env DRIZZLE_ENV=dev drizzle-kit migrate",
    "db:migrate:prod": "dotenvx run -f .env.drizzle -- env DRIZZLE_ENV=prod drizzle-kit migrate",
    "db:studio:dev": "dotenvx run -f .env.drizzle -- env DRIZZLE_ENV=dev drizzle-kit studio --port 4983",
    "db:studio:staging": "dotenvx run -f .env.drizzle -- env DRIZZLE_ENV=staging drizzle-kit studio --port 4984",
    "db:studio:prod": "dotenvx run -f .env.drizzle -- env DRIZZLE_ENV=prod drizzle-kit studio --port 4985",
    "secret:set": "dotenvx set -f .env",
    "secret:show": "dotenvx get -f .env",
    "better-auth-generate": "npx @better-auth/cli@latest generate --config src/server/infrastructure/auth/auth-gen.ts --output src/server/infrastructure/db/schema/auth.schemas.ts -y",
    "logs": "wrangler tail --env staging --format pretty",
    "logs:prod": "wrangler tail --env prod --format pretty",
    "tunnel": "dotenvx run -- ../../scripts/tunnel.sh"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.65",
    "@ai-sdk/provider-utils": "^4.0.27",
    "@base-ui/react": "catalog:",
    "@better-auth/stripe": "catalog:",
