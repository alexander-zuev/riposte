{
  "name": "riposte",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "./scripts/dev.sh",
    "tunnel": "pnpm --filter @riposte/web tunnel",
    "build": "turbo run build",
    "build:core": "pnpm --filter @riposte/core run build",
    "build:prod": "turbo run build:prod",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:integration": "pnpm --filter @riposte/web run test:integration",
    "storybook": "pnpm --filter @riposte/web run storybook",
    "deploy": "pnpm --filter @riposte/web run deploy",
    "deploy:prod": "pnpm --filter @riposte/web run deploy:prod",
    "db:generate": "pnpm --filter @riposte/web run db:generate",
    "db:migrate:dev": "pnpm --filter @riposte/web run db:migrate:dev",
    "db:migrate:prod": "pnpm --filter @riposte/web run db:migrate:prod",
    "db:reset": "docker compose down -v && docker compose up -d postgres --wait && pnpm db:migrate:dev",
    "db:start": "docker compose up -d postgres --wait",
    "db:stop": "docker compose down",
    "db:studio:dev": "pnpm --filter @riposte/web run db:studio:dev",
    "db:studio:prod": "pnpm --filter @riposte/web run db:studio:prod",
    "tail": "pnpm --filter @riposte/web run logs:prod",
    "tail:staging": "pnpm --filter @riposte/web run logs",
    "cf-typegen": "pnpm --filter @riposte/web run cf-typegen"
  },
  "devDependencies": {
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "tsx": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "**/!(*.d).{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --write",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ]
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f"
}
